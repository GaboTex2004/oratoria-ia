AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=8000
APP_ENV=development
INTERNAL_API_KEY=replace-with-a-random-shared-key
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
# GPU profile tested on RTX 4050 6 GiB:
# OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
# LLM_NUM_GPU=99
LLM_TIMEOUT_SECONDS=240
LLM_NUM_GPU=0
LLM_CONTEXT_TOKENS=4096
INFERENCE_THREADS=4
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Optional absolute paths; defaults use ai-service/models/.
# WHISPER_MODEL_PATH=C:/oratoria-ia-main/ai-service/models/whisper-base
# POSE_MODEL_PATH=C:/oratoria-ia-main/ai-service/models/pose_landmarker_lite.task
AUDIO_MAX_SIZE_BYTES=15728640
AUDIO_MAX_DURATION_SECONDS=300
SIMULATION_LLM_PROVIDER=ollama
SIMULATION_EVALUATION_PROVIDER=ollama
