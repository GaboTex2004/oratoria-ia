AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=8000
SPRING_API_URL=http://localhost:8081/api
APP_ENV=development
INTERNAL_API_KEY=replace-with-shared-internal-service-key
GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_MODEL=whisper-large-v3-turbo
GROQ_TIMEOUT_SECONDS=60
GROQ_LLM_MODEL=openai/gpt-oss-120b
GROQ_LLM_TIMEOUT_SECONDS=45
EVALUATION_MIN_WORDS=10
EVALUATION_MIN_DURATION_SECONDS=4.0
AUDIO_MAX_SIZE_BYTES=15728640
AUDIO_MAX_DURATION_SECONDS=300
SIMULATION_MIN_USER_TURNS=2
SIMULATION_MAX_HISTORY_MESSAGES=12
SIMULATION_MAX_MESSAGE_CHARS=2000
SIMULATION_LLM_PROVIDER=gemini
SIMULATION_EVALUATION_PROVIDER=gemini
SIMULATION_GROQ_MODEL=openai/gpt-oss-120b
SIMULATION_GEMINI_MODEL=gemini-3.8-flash
SIMULATION_GEMINI_REPLY_THINKING_LEVEL=low
SIMULATION_GEMINI_FEEDBACK_THINKING_LEVEL=medium
GEMINI_API_KEY=replace-with-your-gemini-api-key
