SERVER_PORT=8081
DB_URL=jdbc:postgresql://localhost:5434/oratoria_db
DB_USERNAME=postgres
DB_PASSWORD=postgres
CORS_ALLOWED_ORIGIN=http://localhost:5173
AI_SERVICE_URL=http://localhost:8000
INTERNAL_API_KEY=replace-with-shared-internal-service-key
AI_SERVICE_TIMEOUT_SECONDS=65
ANALYSIS_ASYNC_ENABLED=true
ANALYSIS_MAX_ATTEMPTS=3
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRATION_MS=86400000
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_FIRST_NAME=Administrador
ADMIN_LAST_NAME=Oratoria IA
AUDIO_STORAGE_DIR=./data/audio
AUDIO_MAX_SIZE_BYTES=15728640
AUDIO_MAX_DURATION_SECONDS=300
