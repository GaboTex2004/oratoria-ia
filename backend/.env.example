SERVER_PORT=8081
DB_URL=jdbc:postgresql://127.0.0.1:5435/oratoria_db
DB_USERNAME=postgres
DB_PASSWORD=postgres
CORS_ALLOWED_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
AI_SERVICE_URL=http://localhost:8000
INTERNAL_API_KEY=replace-with-shared-internal-service-key
AI_SERVICE_TIMEOUT_SECONDS=300
ANALYSIS_ASYNC_ENABLED=true
ANALYSIS_MAX_ATTEMPTS=3
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRATION_MS=86400000
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=Administrador
ADMIN_LAST_NAME=Oratoria IA
APP_PROFILE=dev
# Existing schemas only, after backup and comparison with V1; false for a new DB.
FLYWAY_BASELINE_ON_MIGRATE=false
DEMO_FREE_EMAIL=
DEMO_FREE_PASSWORD=
DEMO_PREMIUM_EMAIL=
DEMO_PREMIUM_PASSWORD=
AUDIO_STORAGE_DIR=./data/audio
AUDIO_MAX_SIZE_BYTES=15728640
AUDIO_MAX_DURATION_SECONDS=300
