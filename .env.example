# Up-Docker.ps1 creates the ignored .env file and generates the three secrets.
FRONTEND_PORT=15173
ORATORIA_DB_NAME=oratoriaai_local
ORATORIA_DB_USER=oratoria
ORATORIA_DB_PASSWORD=replace-with-generated-secret
JWT_SECRET=replace-with-generated-secret
INTERNAL_API_KEY=replace-with-generated-secret
OLLAMA_MODEL=qwen2.5:1.5b
APP_PROFILE=dev
BILLING_DEMO_ENABLED=true
ADMIN_EMAIL=admin@oratoria.local
ADMIN_PASSWORD=replace-with-generated-secret
